// viewora/server/prisma/schema.prisma
// v1.5 – generated from VIEWORA Project Documentation v1.5

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  customer
  admin
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
}

enum FulfillmentStatus {
  unfulfilled
  processing
  shipped
  delivered
  cancelled
}

enum PaymentTxStatus {
  initiated
  success
  failed
}

enum ReservationStatus {
  active
  released
  fulfilled
}

enum RefundStatus {
  initiated
  processing
  completed
  failed
}

enum RefundInitiator {
  customer
  admin
  system
}

// v1.1 enums (pre-planned)
enum CouponStatus {
  active
  used
  expired
}

enum ReferralStatus {
  pending
  qualified
}

// ── Models ─────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?  @unique
  passwordHash String?  @map("password_hash")
  role         Role     @default(customer)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens  RefreshToken[]
  addresses      Address[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orders         Order[]
  // v1.1
  coupons        Coupon[]
  referralsGiven Referral[]     @relation("ReferrerRelation")
  referralsGot   Referral[]     @relation("ReferredRelation")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Address {
  id         String  @id @default(uuid())
  userId     String? @map("user_id")
  guestEmail String? @map("guest_email")
  label      String?
  name       String
  phone      String?
  line1      String
  line2      String?
  city       String
  state      String
  pincode    String
  isDefault  Boolean @default(false) @map("is_default")

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders Order[]

  @@map("addresses")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  slug     String    @unique
  products Product[]

  @@map("categories")
}

model Collection {
  id          String              @id @default(uuid())
  name        String              @unique
  slug        String              @unique
  description String?
  products    ProductCollection[]

  @@map("collections")
}

model Product {
  id               String    @id @default(uuid())
  name             String
  slug             String    @unique
  brand            String?
  description      String?
  categoryId       String    @map("category_id")
  defaultImageUrls String[]  @map("default_image_urls")
  startingPrice    Decimal   @default(0) @map("starting_price") @db.Decimal(10, 2)
  isActive         Boolean   @default(true) @map("is_active")
  deletedAt        DateTime? @map("deleted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  category      Category            @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  collections   ProductCollection[]
  wishlistItems WishlistItem[]

  @@index([slug])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  sku       String   @unique
  color     String?
  size      String?
  lensType  String?  @map("lens_type")
  material  String?
  price     Decimal  @db.Decimal(10, 2)
  stock     Int      @default(0)
  imageUrls String[] @map("image_urls")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product           Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  stockReservations StockReservation[]

  @@index([productId])
  @@map("product_variants")
}

model ProductCollection {
  productId    String @map("product_id")
  collectionId String @map("collection_id")

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@map("product_collections")
}

model CartItem {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  variantId String @map("variant_id")
  quantity  Int

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([userId, variantId])
  @@index([userId])
  @@map("cart_items")
}

model WishlistItem {
  id        String @id @default(uuid())
  userId    String @map("user_id")
  productId String @map("product_id")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// v1.1 pre-planned — schema table exists, endpoints inactive until v1.1
model Coupon {
  id         String       @id @default(uuid())
  code       String       @unique
  value      Decimal      @db.Decimal(10, 2)
  userId     String?      @map("user_id")
  guestEmail String?      @map("guest_email")
  guestPhone String?      @map("guest_phone")
  status     CouponStatus @default(active)
  expiresAt  DateTime     @map("expires_at")
  createdAt  DateTime     @default(now()) @map("created_at")
  usedAt     DateTime?    @map("used_at")

  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  orders    Order[]
  referrals Referral[]

  @@index([code])
  @@index([userId])
  @@map("coupons")
}

model Order {
  id                 String            @id @default(uuid())
  userId             String?           @map("user_id")
  guestEmail         String?           @map("guest_email")
  guestPhone         String?           @map("guest_phone")
  addressId          String?           @map("address_id")
  shippingName       String?           @map("shipping_name")
  shippingLine1      String?           @map("shipping_line1")
  shippingLine2      String?           @map("shipping_line2")
  shippingCity       String?           @map("shipping_city")
  shippingState      String?           @map("shipping_state")
  shippingPincode    String?           @map("shipping_pincode")
  paymentStatus      PaymentStatus     @default(pending) @map("payment_status")
  fulfillmentStatus  FulfillmentStatus @default(unfulfilled) @map("fulfillment_status")
  appliedCouponId    String?           @map("applied_coupon_id")
  subtotal           Decimal           @db.Decimal(10, 2)
  discountAmount     Decimal           @default(0) @map("discount_amount") @db.Decimal(10, 2)
  shippingFee        Decimal           @default(99) @map("shipping_fee") @db.Decimal(10, 2)
  finalPayableAmount Decimal           @map("final_payable_amount") @db.Decimal(10, 2)
  trackingNumber     String?           @map("tracking_number")
  carrier            String?           @default("DTDC")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  user          User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  address       Address?           @relation(fields: [addressId], references: [id])
  appliedCoupon Coupon?            @relation(fields: [appliedCouponId], references: [id])
  items         OrderItem[]
  payment       Payment?
  reservations  StockReservation[]
  refunds       Refund[]

  @@index([userId])
  @@index([paymentStatus])
  @@index([fulfillmentStatus])
  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String  @map("order_id")
  variantId       String  @map("variant_id")
  skuSnapshot     String  @map("sku_snapshot")
  quantity        Int
  priceAtPurchase Decimal @map("price_at_purchase") @db.Decimal(10, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model StockReservation {
  id         String            @id @default(uuid())
  variantId  String            @map("variant_id")
  orderId    String            @map("order_id")
  quantity   Int
  reservedAt DateTime          @default(now()) @map("reserved_at")
  expiresAt  DateTime          @map("expires_at")
  status     ReservationStatus @default(active)

  variant ProductVariant @relation(fields: [variantId], references: [id])
  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("stock_reservations")
}

model Payment {
  id                    String          @id @default(uuid())
  orderId               String          @unique @map("order_id")
  merchantTransactionId String          @unique @map("merchant_transaction_id")
  phonepeTransactionId  String?         @unique @map("phonepe_transaction_id")
  status                PaymentTxStatus @default(initiated)
  amount                Decimal         @db.Decimal(10, 2)
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id])
  refunds Refund[]

  @@index([merchantTransactionId])
  @@map("payments")
}

model PaymentCallbackLog {
  id                    String   @id @default(uuid())
  merchantTransactionId String   @map("merchant_transaction_id")
  rawPayload            Json     @map("raw_payload")
  checksumValid         Boolean  @map("checksum_valid")
  processed             Boolean  @default(false)
  receivedAt            DateTime @default(now()) @map("received_at")

  @@index([merchantTransactionId])
  @@map("payment_callback_logs")
}

model Refund {
  id              String          @id @default(uuid())
  orderId         String          @map("order_id")
  paymentId       String          @map("payment_id")
  phonepeRefundId String?         @map("phonepe_refund_id")
  amount          Decimal         @db.Decimal(10, 2)
  reason          String
  status          RefundStatus    @default(initiated)
  initiatedBy     RefundInitiator @map("initiated_by")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([orderId])
  @@map("refunds")
}

// v1.1 pre-planned
model Referral {
  id                String         @id @default(uuid())
  referrerId        String         @map("referrer_id")
  referredUserId    String?        @map("referred_user_id")
  status            ReferralStatus @default(pending)
  generatedCouponId String?        @map("generated_coupon_id")
  createdAt         DateTime       @default(now()) @map("created_at")

  referrer        User    @relation("ReferrerRelation", fields: [referrerId], references: [id])
  referredUser    User?   @relation("ReferredRelation", fields: [referredUserId], references: [id])
  generatedCoupon Coupon? @relation(fields: [generatedCouponId], references: [id])

  @@map("referrals")
}

model OtpVerification {
  id           String   @id @default(uuid())
  email        String   @unique
  purpose      String   // "signup" or "forgot_password"
  otp          String
  expiresAt    DateTime @map("expires_at")
  name         String?  // stored temporarily for signup
  phone        String?  // stored temporarily for signup
  passwordHash String?  @map("password_hash") // stored temporarily for signup
  referrerId   String?  @map("referrer_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

model Subscriber {
  id           String   @id @default(uuid())
  email        String   @unique
  isActive     Boolean  @default(true) @map("is_active")
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("subscribers")
}
