# ─────────── Database ───────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/viewora?schema=public"

# ─────────── App ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# ─────────── JWT ─────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_random_64_char_string
JWT_REFRESH_SECRET=replace_with_another_random_64_char_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─────────── PhonePe ─────────────────────────────────────────────────────────
PHONEPE_ENV=sandbox
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL_SANDBOX=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_BASE_URL_PRODUCTION=https://api.phonepe.com/apis/hermes
PHONEPE_REDIRECT_URL=http://localhost:3000/payment/status
PHONEPE_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback

# ─────────── Razorpay ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# ─────────── Email (SMTP Hosting / Brevo / Hostinger / AWS SES) ───────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=b00614001@smtp-brevo.com
EMAIL_PASS=your_smtp_password
EMAIL_FROM=noreply@viewora.in
EMAIL_SECURE=false               # true for SSL port 465, false for STARTTLS port 587
EMAIL_REJECT_UNAUTHORIZED=false  # set to false to prevent self-signed TLS cert rejections on hosting servers

# ─────────── Cloudflare R2 ───────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=viewora-assets
R2_CDN_URL=https://pub-6bbb8cfdaf924bbbb21aaeeaed84a66e.r2.dev

# ─────────── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=debug
