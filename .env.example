# ─────────────────────────────────────────────────────────────────────────────
# VIEWORA — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git — it is already in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=viewora_db
DATABASE_URL=postgresql://postgres:change_me_strong_password@postgres:5432/viewora_db?schema=public&connection_limit=10&pool_timeout=20

# ── JWT Secrets (generate new ones: openssl rand -hex 32) ────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Frontend URLs ─────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
# Production (set on Azure client container):
# BACKEND_URL=https://viewora-api-app.azurewebsites.net
# INTERNAL_API_URL=http://viewora-server:5000/api/v1
# NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ── PhonePe Payments ──────────────────────────────────────────────────────────
PHONEPE_ENV=sandbox
PHONEPE_MERCHANT_ID=YOUR_PHONEPE_MERCHANT_ID
PHONEPE_SALT_KEY=YOUR_PHONEPE_SALT_KEY
PHONEPE_SALT_INDEX=1
# Local dev:
PHONEPE_REDIRECT_URL=http://localhost:3000/payment/status
PHONEPE_CALLBACK_URL=http://localhost:5000/api/v1/payments/callback
# Production (set on Azure):
# PHONEPE_REDIRECT_URL=https://viewora.in/payment/status
# PHONEPE_CALLBACK_URL=https://viewora-api-app.azurewebsites.net/api/v1/payments/callback

# ── Email / SMTP (Brevo) ──────────────────────────────────────────────────────
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=YOUR_BREVO_SMTP_LOGIN
EMAIL_PASS=YOUR_BREVO_SMTP_PASSWORD
EMAIL_FROM=noreply@viewora.in
CONTACT_RECIPIENT_EMAIL=support@viewora.in

# ── Cloudinary (product image uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=YOUR_CLOUDINARY_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
